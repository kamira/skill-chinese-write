  "kinds": {
    "spec": {
      "label": "規格書",
      "allow_figurative": 0,
      "require_numbering": true,
      "numbering_pattern": "^\\s*\\d+(\\.\\d+)+[\\s.、)]",
      "min_absolute_verb_ratio": 0.3,
      "absolute_verbs": ["必須", "應該", "應當", "務必", "不可", "不得", "禁止"],
      "absolute_verbs_reason": "刻意不收單字的「應」與「需」。中文沒有詞界,子字串比對會讓「回應時間」「需求」都算成絕對動詞,把比例灌水成假的通過——一個只會變綠的指標等於沒有指標。寧可漏抓「應」的合法用法,也不要讓比例說謊。",
      "require_diagram": false,
      "require_sections": []
    },
    "arch": {
      "label": "架構說明",
      "allow_figurative": 2,
      "require_numbering": false,
      "numbering_pattern": "^\\s*\\d+(\\.\\d+)+[\\s.、)]",
      "min_absolute_verb_ratio": 0.0,
      "absolute_verbs": [],
      "require_diagram": true,
      "require_sections": ["權衡", "取捨", "trade-off", "Trade-off", "決策"]
    }
  },

  "diagram_patterns": [
    "^```\\s*mermaid",
    "^!\\[",
    "[┌┐└┘├┤┬┴┼─│]",
    "^\\s*[+][-]{2,}[+]"
  ],
  "diagram_reason": "認三種畫法:mermaid 區塊、markdown 圖片、ASCII 方框。認不出的畫法用 --allow-no-diagram 放行,而那個旗標會被記錄——放行要留痕,不能靜悄悄過。"
