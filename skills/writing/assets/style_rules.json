{
  "schema_version": "1.0",
  "note": "writing skill 的風格規則單一真相。人類可讀版在 references/ai-tells.md 與 references/voice.md;兩邊不同步時以本檔為準。執行者:scripts/style_check.py",
  "hard_bans": [
    { "term": "值得注意的是", "group": "膠水", "fix": "整句刪掉" },
    { "term": "值得一提的是", "group": "膠水", "fix": "整句刪掉" },
    { "term": "不可否認", "group": "膠水", "fix": "刪掉,直接講事實" },
    { "term": "毋庸置疑", "group": "膠水", "fix": "刪掉" },
    { "term": "眾所周知", "group": "膠水", "fix": "刪掉;真的眾所周知就不用講" },
    { "term": "綜上所述", "group": "膠水", "fix": "刪掉,結尾不要總結" },
    { "term": "總的來說", "group": "膠水", "fix": "刪掉" },
    { "term": "總而言之", "group": "膠水", "fix": "刪掉" },
    { "term": "由此可見", "group": "膠水", "fix": "刪掉,讓讀者自己看見" },
    { "term": "換言之", "group": "膠水", "fix": "刪掉;要換句話說就直接說清楚一次" },
    { "term": "一言以蔽之", "group": "膠水", "fix": "刪掉" },
    { "term": "在一定程度上", "group": "膠水", "fix": "刪掉,或講清楚是哪個程度" },
    { "term": "從某種程度上", "group": "膠水", "fix": "刪掉" },

    { "term": "近年來", "group": "開場罐頭", "fix": "直接進場,背景邊走邊餵" },
    { "term": "在當今社會", "group": "開場罐頭", "fix": "刪掉" },
    { "term": "當今時代", "group": "開場罐頭", "fix": "刪掉" },
    { "term": "時代的浪潮", "group": "開場罐頭", "fix": "刪掉" },
    { "term": "歷史的必然", "group": "開場罐頭", "fix": "刪掉" },
    { "pattern": "隨著[^,。;、!?\\n]{0,14}的發展", "label": "隨著⋯⋯的發展", "group": "開場罐頭", "fix": "刪掉整個開場,從具體場景進去" },
    { "pattern": "在[^,。;、!?\\n]{0,16}的背景下", "label": "在⋯⋯的背景下", "group": "開場罐頭", "fix": "刪掉" },
    { "pattern": "在這個[^,。;、!?\\n]{0,12}的時代", "label": "在這個⋯⋯的時代", "group": "開場罐頭", "fix": "刪掉" },

    { "term": "具有重要意義", "group": "空心評價", "fix": "講出對誰重要、重要在哪" },
    { "term": "產生了深遠的影響", "group": "空心評價", "fix": "講出具體發生了什麼" },
    { "term": "引發了廣泛關注", "group": "空心評價", "fix": "講誰在關注、關注什麼" },
    { "term": "引起熱議", "group": "空心評價", "fix": "講誰在吵、吵什麼" },
    { "term": "必由之路", "group": "空心評價", "fix": "刪掉" },
    { "term": "雙刃劍", "group": "空心評價", "fix": "換成具體的得與失" },
    { "term": "敲響了警鐘", "group": "空心評價", "fix": "講清楚在警告什麼" },
    { "pattern": "(起到|發揮)了?[^,。;、!?\\n]{0,10}作用", "label": "起到/發揮⋯⋯作用", "group": "空心評價", "fix": "講出實際做了什麼" },
    { "pattern": "是[^,。;、!?\\n]{0,12}的重要一環", "label": "是⋯⋯的重要一環", "group": "空心評價", "fix": "刪掉" },

    { "term": "進行了", "group": "動詞被架空", "fix": "直接用後面那個動詞" },
    { "term": "予以", "group": "動詞被架空", "fix": "直接用動詞" },
    { "term": "加以", "group": "動詞被架空", "fix": "直接用動詞" },
    { "term": "深化", "group": "動詞被架空", "fix": "講清楚做了什麼" },
    { "term": "打造", "group": "動詞被架空", "fix": "做出 / 建立 / 蓋" },
    { "term": "助力", "group": "動詞被架空", "fix": "幫 / 推一把" },

    { "term": "極大地", "group": "廢副詞", "fix": "刪掉" },
    { "term": "深刻地", "group": "廢副詞", "fix": "刪掉" },
    { "term": "更好地", "group": "廢副詞", "fix": "刪掉" },
    { "term": "全方位", "group": "廢副詞", "fix": "刪掉" },
    { "term": "多維度", "group": "廢副詞", "fix": "刪掉" },
    { "term": "深層次", "group": "廢副詞", "fix": "刪掉" },

    { "term": "賦能", "group": "管理黑話", "fix": "講清楚給了什麼" },
    { "term": "抓手", "group": "管理黑話", "fix": "切入點 / 做法" },
    { "term": "閉環", "group": "管理黑話", "fix": "講清楚流程接上了哪一段" },
    { "term": "顆粒度", "group": "管理黑話", "fix": "細到什麼程度" },
    { "term": "對標", "group": "管理黑話", "fix": "比照 / 跟⋯⋯比" },
    { "term": "頂層設計", "group": "管理黑話", "fix": "刪掉" },
    { "term": "底層邏輯", "group": "管理黑話", "fix": "刪掉,直接講那個邏輯" },
    { "term": "生態位", "group": "管理黑話", "fix": "刪掉" },
    { "term": "制度", "group": "管理黑話", "fix": "講那個法規或單位的名字;引用原文才放行(--allow 制度)" },
    { "term": "窗口", "group": "管理黑話", "fix": "講具體找誰、走哪個流程;引用原文才放行(--allow 窗口)" },

    { "term": "筆者", "group": "藏起自己", "fix": "我" },
    { "term": "本文", "group": "藏起自己", "fix": "刪掉" },
    { "term": "我們可以看到", "group": "藏起自己", "fix": "我看到 / 你會發現" },
    { "term": "不難發現", "group": "藏起自己", "fix": "刪掉,直接講發現了什麼" },
    { "term": "可以說", "group": "藏起自己", "fix": "刪掉" },
    { "term": "讓我們", "group": "藏起自己", "fix": "刪掉" },
    { "term": "值得我們", "group": "藏起自己", "fix": "刪掉" },
    { "term": "作為一名", "group": "藏起自己", "fix": "刪掉" },

    { "pattern": "不僅僅?是[^。!?\\n]{0,40}更是", "label": "不僅僅是⋯⋯更是⋯⋯", "group": "招牌句式", "fix": "直接講深刻的那一層,不要用句式暗示" },

    { "pattern": "(?:不是|並非|不只是|不止是|不僅是)[^。!?\\n]{0,32}(?:而是|而在於)", "label": "不是 A,而是 B", "group": "句型殼", "fix": "A 是墊話就刪掉直接講 B;兩邊都要就寫成它們的實際關係,別擺出糾正的姿態" },
    { "pattern": "與其說[^。!?\\n]{0,32}不如說", "label": "與其說⋯⋯不如說⋯⋯", "group": "句型殼", "fix": "直接講你認為它是什麼" },
    { "pattern": "不在於[^。!?\\n]{0,24}而在於", "label": "不在於⋯⋯而在於⋯⋯", "group": "句型殼", "fix": "同上,直接講落點" },
    { "pattern": "[^。!?\\n]{1,18}很簡單[：:]", "label": "X 很簡單:", "group": "句型殼", "fix": "刪掉這句開場,把後面那個具體條件講出來" },
    { "term": "答案很簡單", "group": "句型殼", "fix": "刪掉,直接給答案" },
    { "term": "真正重要的是", "group": "句型殼", "fix": "直接講那個東西,不要先宣告它重要" },
    { "term": "核心在於", "group": "句型殼", "fix": "直接講" },
    { "pattern": "第一步[^。!?\\n]{0,60}第二步", "label": "第一步⋯⋯第二步", "group": "句型殼", "fix": "評論不是 SOP;順序真的會改變結果才留" },

    { "term": "下面我們來", "group": "助理路標", "fix": "刪掉,直接進內容" },
    { "term": "接下來我會", "group": "助理路標", "fix": "刪掉" },
    { "term": "希望這能幫到你", "group": "助理路標", "fix": "刪掉" },
    { "term": "在這個過程中", "group": "助理路標", "fix": "刪掉" },
    { "term": "這背後其實", "group": "助理路標", "fix": "刪掉,直接講背後是什麼" },

    { "term": "你覺得呢", "group": "結尾互動", "fix": "刪掉。評論的結尾要往前推半步,不是討拍" },
    { "term": "是不是很有啟發", "group": "結尾互動", "fix": "刪掉" },
    { "pattern": "你有沒有[^。!?\\n]{0,12}經歷", "label": "你有沒有⋯⋯經歷", "group": "結尾互動", "fix": "刪掉" },
    { "term": "不知道你怎麼看", "group": "結尾互動", "fix": "刪掉" },
    { "pattern": "你(?:現在)?卡在哪", "label": "你卡在哪⋯⋯", "group": "結尾互動", "fix": "刪掉" }
  ],
  "soft_limits": [
    { "term": "機制", "per_1000": 2 },
    { "term": "維度", "per_1000": 1 },
    { "term": "層面", "per_1000": 2 },
    { "term": "本質上", "per_1000": 1 },
    { "term": "系統性", "per_1000": 2 },
    { "term": "結構性", "per_1000": 3 },
    { "term": "邏輯", "per_1000": 3 },
    { "term": "生態", "per_1000": 2 },
    { "term": "模式", "per_1000": 3 },
    { "term": "路徑", "per_1000": 2 },
    { "term": "面向", "per_1000": 2 },
    { "term": "因此", "per_1000": 3 },
    { "term": "然而", "per_1000": 3 },
    { "term": "從而", "per_1000": 1 },
    { "term": "進而", "per_1000": 1 },
    { "term": "首先", "per_1000": 1 },
    { "term": "其次", "per_1000": 1 },
    { "term": "進一步", "per_1000": 2 },
    { "term": "其實", "per_1000": 3 },
    { "term": "事實上", "per_1000": 2 },
    { "term": "確實", "per_1000": 3 },
    { "term": "賽道", "per_1000": 1 },
    { "term": "風口", "per_1000": 1 },
    { "term": "護城河", "per_1000": 1 },
    { "term": "天花板", "per_1000": 1 },
    { "term": "心智", "per_1000": 1 },
    { "term": "優化", "per_1000": 2 },
    { "term": "落地", "per_1000": 2 },
    { "term": "凸顯", "per_1000": 1 },
    { "term": "賦予", "per_1000": 1 },
    { "pattern": "先[^，,。!?\\n]{0,24}(?:再|然後|接著|隨後)", "label": "先⋯⋯再⋯⋯", "per_1000": 2 },
    { "pattern": "真正[^，,。!?\\n]{0,16}(?:的是|在於|決定)", "label": "真正⋯⋯的是", "per_1000": 1 },
    { "pattern": "從[^，,。!?\\n]{1,12}到[^，,。!?\\n]{1,12}", "label": "從 A 到 B", "per_1000": 2 }
  ],
  "locale_swaps": [
    { "cn": "質量", "tw": "品質" },
    { "cn": "視頻", "tw": "影片" },
    { "cn": "音頻", "tw": "音訊" },
    { "cn": "軟件", "tw": "軟體" },
    { "cn": "硬件", "tw": "硬體" },
    { "cn": "信息", "tw": "資訊" },
    { "cn": "網絡", "tw": "網路" },
    { "cn": "用戶", "tw": "使用者" },
    { "cn": "服務器", "tw": "伺服器" },
    { "cn": "內存", "tw": "記憶體" },
    { "cn": "屏幕", "tw": "螢幕" },
    { "cn": "打印", "tw": "列印" },
    { "cn": "博客", "tw": "部落格" },
    { "cn": "默認", "tw": "預設" },
    { "cn": "激活", "tw": "啟用" },
    { "cn": "高清", "tw": "高畫質" },
    { "cn": "智能", "tw": "智慧" },
    { "cn": "項目", "tw": "專案" },
    { "cn": "渠道", "tw": "管道 / 通路" },
