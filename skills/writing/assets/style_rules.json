    { "cn": "通過", "tw": "透過(表方式時)" },
    { "cn": "立馬", "tw": "馬上" },
    { "cn": "接地氣", "tw": "貼近現實" },
    { "cn": "說白了", "tw": "講白了" },
    { "cn": "劃重點", "tw": "畫重點" },
    { "cn": "靠譜", "tw": "可靠 / 有譜" },
    { "cn": "貓膩", "tw": "蹊蹺 / 有鬼" },
    { "cn": "高大上", "tw": "體面 / 派頭十足" },
    { "cn": "走心", "tw": "用心" }
  ],
  "rhythm": {
    "min_cv": 0.35,
    "healthy_cv": 0.45,
    "flat_run_len": 3,
    "flat_run_tolerance": 2,
    "max_sentence_chars": 60,
    "require_short_sentence_under": 8,
    "paragraph": {
      "_doc": "段落層級的節奏。看實質段落(跳過標題、條列、表格、程式碼)。min_chars 只用來濾掉散落的碎片,短段落必須算進統計——它正是要獎勵的節奏變化,濾掉的話「插一個短段」這個建議就不會生效",
      "min_chars": 4,
      "min_count": 4,
      "max_flat_range": 25,
      "min_cv": 0.25
    }
  },
  "shape": {
    "_doc": "段落/句子的模板形狀。命中只警告,不擋",
    "hen_judgment_max": 2,
    "colon_template_max": 2,
    "colon_label_max_chars": 12
  },
  "ending": {
    "_doc": "結尾兩條硬規。(1) 最後一句是問號結尾且點名讀者 → 硬性違規;純反詰(不點名)不受影響。(2) 最後一句字數低於 min_final_sentence_chars → 硬性違規:不准拿一句短話當總結,結尾要落在有內容的長句上,把文章留在還開著的狀態",
    "forbid_engagement_question": true,
    "person_markers": ["你", "妳", "大家", "各位"],
    "tail_sentences": 1,
    "min_final_sentence_chars": 12
  },
  "bullets": {
    "_doc": "條列規範。只有議題型的現象節該用條列,每項只放扼要重點、禁止完整說明。條列本來就短而齊,拿散文的節奏標準去量必然誤報,故整組排除在句子層級的判定之外",
    "max_chars": 16,
    "exempt_from": ["sentence_stats", "symmetry", "aphorism", "bold_limit"]
  },
  "headings": {
    "_doc": "小標要有內容,最好本身就是一個判斷。議題型的三個必要節屬功能名,直接用不算違規;可選的那一節(反觀/省思)必須具體——用結構標籤等於什麼都沒說",
    "discouraged": ["前言", "背景", "分析", "結論", "總結", "概述", "簡介", "反觀", "省思", "引言", "小結"],
    "issue_sections": ["現象", "結語", "後記"]
  },
  "symmetry": {
    "_doc": "字數對稱句本身的配額。總量與位置由 aphorism 節管",
    "max_total": 3,
    "min_gap_sentences": 3,
    "min_clause_chars": 4
  },
  "aphorism": {
    "_doc": "刻意雕的句子——明喻、字數對稱、落在段末的斷語。偶爾可以,不能是常態,所以管的是總量與位置,不是禁止。一律警告,不進硬性違規。隱喻不計:它與一般敘述無法機器區分",
    "simile_pattern": "(?<![好想影圖印不沒很更最都也])像(?![樣是的])[^，,。！？!?、;；\\n]{3,}",
    "antithesis_pattern": "([\\u4e00-\\u9fff]{1,2})[^，,。！？!?\\n]{0,14}[，,]\\1[^，,。！？!?\\n]{0,4}[不沒]",
    "crafted_max": 3,
    "closer_max": 2,
    "min_gap_sentences": 3
  },
  "person": {
    "require_first_person": true,
    "marker": "我",
    "first_hit_within_chars": 200,
    "max_hedge_per_1000": 3,
    "hedges": ["我認為", "我覺得", "在我看來"]
  },
  "layout": {
    "max_bullet_ratio": 0.25,
    "max_em_dash_per_1000": 4,
    "max_bold_per_paragraph": 1
  }
}
